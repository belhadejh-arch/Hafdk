DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=5000
NODE_ENV=development
# Use true only when your PostgreSQL provider requires TLS.
DB_SSL=false
# Add the exact Vercel origin after deployment, for example https://your-site.vercel.app
FRONTEND_ORIGIN=

# Used only for the one-time admin:create command. Set as private environment variables.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
